from urllib.request import (
    Request,
    urlopen
)

from urllib.error import (
    HTTPError,
    URLError
)

from pathlib import Path
import sys


if len(sys.argv) != 2:

    print(
        "Usage: python URLStatusChecker.py urls.txt"
    )

    raise SystemExit


file = Path(
    sys.argv[1]
)


urls = file.read_text(
    encoding="utf-8"
).splitlines()


for url in urls:

    url = url.strip()

    if not url:
        continue

    if not url.startswith(
        ("http://", "https://")
    ):

        url = "https://" + url


    try:

        request = Request(
            url,
            headers={
                "User-Agent":
                "AZZI-URL-Checker/1.0"
            }
        )

        with urlopen(
            request,
            timeout=10
        ) as response:

            print(
                response.status,
                url
            )


    except HTTPError as error:

        print(
            error.code,
            url
        )


    except URLError:

        print(
            "ERROR",
            url
        )
