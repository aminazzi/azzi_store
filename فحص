import sys
import ssl
from urllib.parse import urlparse
from urllib.request import Request, urlopen
from urllib.error import URLError, HTTPError

SUSPICIOUS_WORDS = {
    "phishing",
    "free-money",
    "crack",
    "keygen",
    "malware",
    "credential",
    "password-reset",
    "verify-account"
}


def check_website(url):

    if not url.startswith(("http://", "https://")):
        url = "https://" + url

    parsed = urlparse(url)

    print("================================")
    print("AZZI WEBSITE SAFETY CHECKER")
    print("================================")

    print("URL:", url)

    if parsed.scheme == "https":
        print("HTTPS: YES")
    else:
        print("HTTPS: NO")

    suspicious = []

    for word in SUSPICIOUS_WORDS:
        if word in url.lower():
            suspicious.append(word)

    if suspicious:
        print("Suspicious keywords:", suspicious)
    else:
        print("Suspicious keywords: None")

    try:

        request = Request(
            url,
            headers={
                "User-Agent": "AZZI-Safety-Checker/1.0"
}
        )

        context = ssl.create_default_context()

        with urlopen(
            request,
            timeout=10,
            context=context
        ) as response:

            print("HTTP Status:", response.status)
            print("Final URL:", response.geturl())

            content_type = response.headers.get(
                "Content-Type",
                "Unknown"
            )

            print("Content Type:", content_type)

            frame = response.headers.get(
                "X-Frame-Options"
            )

            if frame:
                print("X-Frame-Options: Present")
            else:
                print("X-Frame-Options: Not Set")

            csp = response.headers.get(
                "Content-Security-Policy"
            )

            if csp:
                print("Security Policy: Present")
            else:
                print("Security Policy: Not Set")

            print()
            print("Basic security check completed.")

    except HTTPError as error:

        print("HTTP Error:", error.code)

    except URLError as error:

        print("Connection Error:", error.reason)

    except Exception as error:

        print("Error:", error)


if __name__ == "__main__":

    if len(sys.argv) != 2:

        print(
            "Usage: python WebsiteSafetyChecker.py https://example.com"
        )

    else:

        check_website(sys.argv[1])
