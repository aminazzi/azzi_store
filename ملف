from pathlib import Path
import sys


if len(sys.argv) < 3:

    print(
        "Usage:"
    )

    print(
        "python FileSearchTool.py FOLDER SEARCH_TERM"
    )

    raise SystemExit


folder = Path(
    sys.argv[1]
).expanduser().resolve()


search_term = " ".join(
    sys.argv[2:]
).lower()


results = []


for file in folder.rglob("*"):

    if not file.is_file():
        continue

    if search_term in file.name.lower():

        results.append(file)


print()
print(
    "Files found:",
    len(results)
)

print()


for file in results:

    print(file)
